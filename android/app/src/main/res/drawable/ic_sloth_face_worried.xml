<?xml version="1.0" encoding="utf-8"?>
<!--
  Worried variant of ic_sloth_face.xml — same head/ears/patches/cheeks/nose
  (unchanged from the base file), with slanted "concerned" eyebrows and a
  small open/worried mouth instead of a smile. Shown by
  TrackMeGoalWidgetProvider when a streak is still incomplete late in the
  day, mirroring how Duolingo's mascot looks anxious in its "It's late!"
  state rather than staying static.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Ears -->
    <path
        android:pathData="M14,28 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z"
        android:fillColor="@color/sloth_fur" />
    <path
        android:pathData="M62,28 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z"
        android:fillColor="@color/sloth_fur" />

    <!-- Base furry head -->
    <path
        android:pathData="M10,54 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 Z"
        android:fillColor="@color/sloth_fur" />

    <!-- Cream face patch -->
    <path
        android:pathData="M23,58 a27,23 0 1,0 54,0 a27,23 0 1,0 -54,0 Z"
        android:fillColor="@color/sloth_face" />

    <!-- Dark "mask" eye patches -->
    <path
        android:pathData="M29,50 a9,12 0 1,0 18,0 a9,12 0 1,0 -18,0 Z"
        android:fillColor="@color/sloth_eye_patch" />
    <path
        android:pathData="M53,50 a9,12 0 1,0 18,0 a9,12 0 1,0 -18,0 Z"
        android:fillColor="@color/sloth_eye_patch" />

    <!-- Worried eyebrows: slanted inward-up, the classic "concerned" cue -->
    <path
        android:pathData="M31,42 L42,45.5"
        android:strokeColor="@color/sloth_eye_patch"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M69,42 L58,45.5"
        android:strokeColor="@color/sloth_eye_patch"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Rosy cheeks -->
    <path
        android:pathData="M23.5,61 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z"
        android:fillColor="@color/sloth_cheek" />
    <path
        android:pathData="M67.5,61 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z"
        android:fillColor="@color/sloth_cheek" />

    <!-- Eyes: slightly taller/rounder for a wide, worried look -->
    <path
        android:pathData="M34.5,48.5 a3.2,4 0 1,0 6.4,0 a3.2,4 0 1,0 -6.4,0 Z"
        android:fillColor="@color/sloth_eye" />
    <path
        android:pathData="M58.5,48.5 a3.2,4 0 1,0 6.4,0 a3.2,4 0 1,0 -6.4,0 Z"
        android:fillColor="@color/sloth_eye" />

    <!-- Nose -->
    <path
        android:pathData="M45.5,63 a4.5,3.2 0 1,0 9,0 a4.5,3.2 0 1,0 -9,0 Z"
        android:fillColor="@color/sloth_eye_patch" />

    <!-- Small worried "o" mouth instead of a smile -->
    <path
        android:pathData="M46.5,69 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z"
        android:strokeColor="@color/sloth_eye_patch"
        android:strokeWidth="2"
        android:fillColor="#00000000" />
</vector>
